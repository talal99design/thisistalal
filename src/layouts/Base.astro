---
import '../styles/global.css';
import MenuBar from '../components/MenuBar.astro';
import Analytics from '../components/Analytics.astro';
const { title = 'Talal Athar — Product Designer', description = 'Engineer turned product designer in Melbourne, Australia. Australian PR with full working rights.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🖥️</text></svg>" />
  <Analytics />
</head>
<body>
  <MenuBar />
  <main class="desktop"><slot /></main>
  <script>
    // Draggable stickers (pointer events, works on touch too)
    document.querySelectorAll<HTMLElement>('[data-drag]').forEach((el) => {
      let sx = 0, sy = 0, ox = 0, oy = 0;
      el.addEventListener('pointerdown', (e) => {
        el.setPointerCapture(e.pointerId);
        sx = e.clientX; sy = e.clientY;
        ox = parseFloat(el.dataset.x || '0'); oy = parseFloat(el.dataset.y || '0');
        el.classList.add('dragging');
      });
      el.addEventListener('pointermove', (e) => {
        if (!el.hasPointerCapture(e.pointerId)) return;
        const x = ox + e.clientX - sx, y = oy + e.clientY - sy;
        el.dataset.x = String(x); el.dataset.y = String(y);
        el.style.translate = `${x}px ${y}px`;
      });
      const end = (e: PointerEvent) => { el.releasePointerCapture(e.pointerId); el.classList.remove('dragging'); };
      el.addEventListener('pointerup', end); el.addEventListener('pointercancel', end);
    });
  </script>
</body>
</html>
