---
// Visitor analytics. Both load after the page, so they don't slow it down.
// 1. Vercel Web Analytics: visitors, countries, devices, pages, referrers.
//    Switch it on in the Vercel dashboard (project > Analytics > Enable).
// 2. Microsoft Clarity: click and scroll heatmaps, time on page, session replays.
//    Paste the project ID from clarity.microsoft.com (Settings > Overview) below,
//    or set PUBLIC_CLARITY_ID in Vercel's environment variables.
const CLARITY_ID = import.meta.env.PUBLIC_CLARITY_ID || '';
const isProd = import.meta.env.PROD;
---
{isProd && <script is:inline defer src="/_vercel/insights/script.js"></script>}
{isProd && <script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>}
{isProd && CLARITY_ID && (
  <script is:inline define:vars={{ id: CLARITY_ID }}>
    (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
    t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
    y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script",id);
  </script>
)}
