---
import { Image } from 'astro:assets';
import Window from './Window.astro';
import chaos from '../assets/eql/chaos.png';
import lx from '../assets/eql/lx.png';
import alex from '../assets/eql/alex.png';
import context from '../assets/eql/context.png';
const cards = [
  { img: alex, title: 'Alex vs. the bots', by: 'A fan’s journey through a hyped drop', tilt: -6 },
  { img: chaos, title: 'The cloud of chaos', by: 'Bots, traffic and crashing sites', tilt: 3 },
  { img: lx, title: 'Launch experience', by: 'Before, during and after the drop', tilt: -2 },
];
const Star = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1.8l3 6.6 7.2.8-5.4 4.9 1.5 7.1L12 17.6l-6.3 3.6 1.5-7.1L1.8 9.2 9 8.4z" fill="#ffd400" stroke="#0a0a0a" stroke-width="1.6" stroke-linejoin="round"/></svg>';
---
<h2 class="folder-label" id="eql"><span class="folder" aria-hidden="true">🔍</span> For the EQL team</h2>
<div class="study-link eql-link" data-href="/eql" data-cursor="view research">
<Window title="eql_research.fig" class="eql-win">
  <div class="eql">
    <div class="eql-copy">
      <p class="eql-kicker">My research on <span class="eql-logo">EQL</span></p>
      <h3 class="eql-h">Making every <span class="hl">launch</span><br />chaotic <em>good</em><span class="eql-star s1" set:html={Star} /></h3>
      <p class="eql-eyebrow">Design challenge</p>
      <p class="eql-q">How might we make a product launch experience chaos‑free (or chaotic good) for both fans and retailers?</p>
      <a class="eql-btn" href="/eql">Explore research <span aria-hidden="true">→</span></a>
    </div>
    <div class="eql-cards" aria-label="Research highlights">
      {cards.map((c, i) => (
        <figure class={`eql-card c${i}`} style={`--t:${c.tilt}deg`}>
          <div class="eql-thumb"><Image src={c.img} alt="" widths={[360, 620]} sizes="300px" /></div>
          <figcaption><strong>{c.title}</strong><span>{c.by}</span></figcaption>
        </figure>
      ))}
      <span class="eql-star s2" set:html={Star} />
      <span class="eql-star s3" set:html={Star} />
    </div>
  </div>
</Window>
</div>
