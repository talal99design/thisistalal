---
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/eql', label: 'EQL Research' },
  { href: '/contact', label: 'Reach Out' },
];
---
<header class="menubar">
  <a href="/" class="apple" aria-label="Home">
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><rect x="1" y="2" width="14" height="10" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M5 14h6" stroke="currentColor" stroke-width="1.5"/><circle cx="6" cy="6.5" r=".9" fill="currentColor"/><circle cx="10" cy="6.5" r=".9" fill="currentColor"/><path d="M6 9q2 1.4 4 0" fill="none" stroke="currentColor" stroke-width="1"/></svg>
  </a>
  <a href="/" class="brand">Talal Athar</a>
  <nav>
    {links.map((l) => <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>)}
  </nav>
  <span class="spacer"></span>
  <span class="status hide-sm">🇦🇺 Melbourne</span>
  <time class="status clock" id="clock">--:--</time>
</header>
<script>
  const el = document.getElementById('clock')!;
  const fmt = new Intl.DateTimeFormat('en-AU', { timeZone: 'Australia/Melbourne', weekday: 'short', hour: 'numeric', minute: '2-digit' });
  const tick = () => (el.textContent = fmt.format(new Date()));
  tick(); setInterval(tick, 20000);
</script>
